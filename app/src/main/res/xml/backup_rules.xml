<?xml version="1.0" encoding="utf-8"?>
<!--
   Backup rules file for Android versions older than API 31 (Android 11 and lower).
   Controls Auto Backup to prevent sensitive WhatsApp notification content and local databases
   from being uploaded to cloud backups or extracted via adb backups.
-->
<full-backup-content>
    <!-- Exclude local database containing tasks, settings, calendar, and captured notifications -->
    <exclude domain="database" path="inbo_tasks.db" />
    <exclude domain="database" path="inbo_tasks.db-journal" />
    <exclude domain="database" path="inbo_tasks.db-wal" />
    <exclude domain="database" path="inbo_tasks.db-shm" />
</full-backup-content>
