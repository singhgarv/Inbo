<?xml version="1.0" encoding="utf-8"?>
<!--
   Data extraction rules file for Android 12+ (API 31+).
   Controls Cloud Backup and Device-to-Device transfer to prevent captured WhatsApp notifications
   and local databases from being uploaded to Google Cloud or extracted to external devices.
-->
<data-extraction-rules>
    <cloud-backup>
        <!-- Exclude local database containing tasks, settings, calendar, and captured notifications -->
        <exclude domain="database" path="inbo_tasks.db" />
        <exclude domain="database" path="inbo_tasks.db-journal" />
        <exclude domain="database" path="inbo_tasks.db-wal" />
        <exclude domain="database" path="inbo_tasks.db-shm" />
    </cloud-backup>
    <device-transfer>
        <!-- Exclude local database during device-to-device transfers / backups -->
        <exclude domain="database" path="inbo_tasks.db" />
        <exclude domain="database" path="inbo_tasks.db-journal" />
        <exclude domain="database" path="inbo_tasks.db-wal" />
        <exclude domain="database" path="inbo_tasks.db-shm" />
    </device-transfer>
</data-extraction-rules>
